{
  "name": "fractal",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run build:portable",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cli": "tsx scripts/fractal.ts",
    "bench": "tsx scripts/fractal.ts bench",
    "bench:browser": "tsx scripts/bench-browser.ts",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:browser": "playwright test",
    "start": "node build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "record:demo": "tsx scripts/record-demo.ts",
    "docs": "tsx scripts/docs.ts",
    "build:portable": "tsx scripts/build-portable.ts",
    "predev": "npm run build:portable"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@marcusv/roc": "^0.2.1",
    "elkjs": "^0.12.0",
    "likec4": "^1.59.3"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "description": "A local-first architecture studio for exploring software models and exporting presentation-quality diagrams.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcus/fractal.git"
  },
  "homepage": "https://github.com/marcus/fractal#readme",
  "bugs": {
    "url": "https://github.com/marcus/fractal/issues"
  }
}
